# --- Database ---
DB_PATH=data/app.db

# --- Dashboard ---
PORT=3000

# --- Region / phone parsing ---
DEFAULT_COUNTRY=ID
REGION=ID
LANGUAGE=id

# --- Kualifikasi lead ---
MIN_SCORE=60
# Deskripsi produk/jasa yang kamu jual. Dipakai AI untuk menilai lead + menyusun pesan.
OFFER=perlengkapan tim olahraga (jersey, alat, sponsorship)

# --- AI (OpenAI-compatible) ---
# Kosong = AI dimatikan, pakai heuristic fallback
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# --- Discovery ---
# duckduckgo (gratis, tanpa key) | google-cse (butuh key+cx)
SEARCH_PROVIDER=duckduckgo
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Google Maps Places API (opsional tapi sangat berguna: nomor langsung)
GOOGLE_MAPS_API_KEY=

# Instagram sessionid (opsional tapi hampir wajib untuk baca bio/link-in-bio).
# Tanpa ini endpoint publik IG sering balas 429.
IG_SESSIONID=

# Kedalaman seed expansion AI: 0 = mati, 1 = satu pass tambahan
AI_SEED_EXPANSION=1
