# --- Database ---
DB_PATH=data/app.db

# --- Dashboard ---
PORT=3000

# --- Region / phone parsing ---
DEFAULT_COUNTRY=ID
REGION=ID
LANGUAGE=id

# --- Outreach guardrails ---
DAILY_SEND_CAP=15
MIN_SCORE=60
# Deskripsi produk/jasa yang kamu jual. Dipakai AI untuk menilai lead.
OFFER=perlengkapan tim olahraga (jersey, alat, sponsorship)

# --- AI (OpenAI-compatible) ---
# Kosong = AI dimatikan, pakai heuristic fallback
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# --- Discovery ---
# duckduckgo (gratis, tanpa key) | google-cse (butuh key+cx)
SEARCH_PROVIDER=duckduckgo
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Google Maps Places API (opsional tapi sangat berguna: nomor langsung)
GOOGLE_MAPS_API_KEY=

# Instagram sessionid (opsional). Tanpa ini baca profil publik sering 401.
IG_SESSIONID=

# --- WhatsApp / Baileys (Fase 2) ---
WA_AUTH_DIR=data/wa-auth
# Jeda acak antar pesan (ms). Jangan diperkecil.
WA_MIN_DELAY_MS=60000
WA_MAX_DELAY_MS=120000
# Interval cek antrean approved (ms)
WA_POLL_MS=30000

