# --- Database ---
DB_PATH=data/app.db

# --- Dashboard ---
PORT=3000

# --- Region / phone parsing ---
DEFAULT_COUNTRY=ID
REGION=ID
LANGUAGE=id

# --- Kualifikasi lead ---
MIN_SCORE=60
# Produk/jasa yang kamu jual. Dipakai AI untuk menilai lead + menyusun pesan.
OFFER=konveksi jersey olahraga custom (jersey tim, akademi, komunitas, turnamen)

# --- AI (OpenAI-compatible) ---
# Kosong = AI dimatikan, pakai heuristic fallback
AI_API_KEY=
AI_BASE_URL=https://ai.sumopod.com/v1
# Lihat id model yang benar: npm run cli -- models
AI_MODEL=deepseek-v4-flash
# auto = coba response_format json_object, kalau ditolak ulangi tanpa (aman)
AI_JSON_MODE=auto

# Kedalaman seed expansion AI: 0 = mati, 1 = satu pass tambahan
AI_SEED_EXPANSION=1

# --- Discovery ---
# auto (searxng->duckduckgo) | searxng | duckduckgo | google-cse
SEARCH_PROVIDER=auto
# Instance SearXNG publik. DuckDuckGo sering blokir; SearXNG lebih tahan.
# Ganti kalau instance ini lambat: https://searx.space
SEARXNG_URL=https://opnxng.com
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Google Maps Places API (Places API (New)) — perlu kartu kredit. Opsional.
GOOGLE_MAPS_API_KEY=

# OpenStreetMap / Nominatim — gratis, tanpa key. Alternatif nomor kalau Maps tak ada.
OSM_ENABLED=1
# Wajib: UA jelas untuk kebijakan Nominatim (boleh diganti kontak kamu).
OSM_UA=number-scrap/0.1 (+https://github.com/wegecorp/number-scrap)

# Instagram sessionid (cookie akun burner). Tanpa ini profil IG balas 429.
IG_SESSIONID=
# Jeda acak antar-fetch profil IG (ms). Naikkan kalau sering kena 429.
IG_FETCH_DELAY_MS=2500
# (Opsional) Proxy untuk request IG, mis. http://user:pass@host:port
# Perlu paket undici: npm i undici . Membantu kalau IP kena rate-limit/blokir.
IG_PROXY_URL=
